# Никогда не публикуйте реальные ключи и не добавляйте .env в Git.
TELEGRAM_TOKEN=replace_with_new_botfather_token
GROQ_API_KEY=replace_with_new_groq_api_key

# Основная модель отвечает по базе, веб-модель включается только при нехватке данных.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WEB_MODEL=groq/compound
ENABLE_WEB_FALLBACK=true
MAX_OUTPUT_TOKENS=700
GROQ_TIMEOUT_SECONDS=90
MAX_KNOWLEDGE_CHARS=3500

# Необязательно. Если оставить пустыми, администратор задаст место командой
# /set_ai_topic внутри нужной темы Telegram.
AI_ALLOWED_CHAT_ID=
AI_ALLOWED_TOPIC_ID=

KNOWLEDGE_FILE=RUSCAR_PRO.txt
RUSCAR_SETTINGS_FILE=data/ruscar_settings.json
LOG_LEVEL=INFO
