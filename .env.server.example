# Точный приватный образ и неизменяемый тег из Docker Hub.
RUSCAR_IMAGE=samvelll/ruscar-bot:1.2.3

# Создайте эти секреты прямо на сервере. Не добавляйте файл .env в образ/Git.
TELEGRAM_TOKEN=replace_with_current_private_telegram_token
GROQ_API_KEY=replace_with_new_private_groq_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WEB_MODEL=groq/compound
ENABLE_WEB_FALLBACK=true
MAX_OUTPUT_TOKENS=700
GROQ_TIMEOUT_SECONDS=90
MAX_KNOWLEDGE_CHARS=3500

# Оставьте пустыми и выполните /set_ai_topic после первого запуска.
AI_ALLOWED_CHAT_ID=
AI_ALLOWED_TOPIC_ID=

LOG_LEVEL=INFO
